rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cada empresa puede leer y escribir solo su propio documento
    // El ID del documento es generado en el cliente y guardado en localStorage
    match /empresas/{empresaId} {
      allow read, write: if true;
      // En producción con auth: allow read, write: if request.auth != null;
    }
  }
}
